
#include "version.hpp"

std::string getVersionString()
{
	return "@export_jpegs_VERSION@";
}

unsigned int getMajorVersion()
{
	return @export_jpegs_VERSION_MAJOR@ +0;
}

unsigned int getMinorVersion()
{
	return @export_jpegs_VERSION_MINOR@ +0;
}

unsigned int getPatchVersion()
{
	return @export_jpegs_VERSION_PATCH@ +0;
}

unsigned int getTweakVersion()
{
	return @export_jpegs_VERSION_TWEAK@ +0;
}
